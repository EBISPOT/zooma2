{
    "embedding": {
        "batch_size": 1000,
        "database_path": "embeddings.db"
    },
    "datasources": {
        "sysmicro": {
            "uri": "https://www.ebi.ac.uk/fg/sym",
            "import_url": "https://www.ebi.ac.uk/cmpo/zooma-cmpo.csv"
        },
        "atlas": {
            "uri": "https://www.ebi.ac.uk/gxa",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/microarray/data/atlas/curation/zoomage_report.CURATED.tsv"
        },
        "ebisc": {
            "uri": "https://cells.ebisc.org/",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/spot/zooma/data/annotations/ebisc/latest/ebisc.tsv"
        },
        "cttv": {
            "uri": "https://www.targetvalidation.org",
            "import_url": "https://raw.githubusercontent.com/opentargets/platform_semantic/master/resources/zooma/cttv_indications.csv"
        },
        "uniprot": {
            "uri": "https://www.ebi.ac.uk/uniprot",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/spot/zooma/data/annotations/uniprot/latest/uniprot_disease.csv"
        },
        "eva-clinvar": {
            "uri": "https://www.ebi.ac.uk/eva",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/eva/ClinVar/latest/eva_clinvar.txt"
        },
        "cbi": {
            "uri": "https://www.ebi.ac.uk/biosamples",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/spot/zooma/data/annotations/cbi/latest/biosample_plant.csv"
        },
        "clinvar-xrefs": {
            "uri": "https://www.ncbi.nlm.nih.gov/clinvar",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/eva/ClinVar/latest/clinvar_xrefs.txt"
        },
        "metabolights": {
            "uri": "https://www.ebi.ac.uk/metabolights",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/metabolights/eb-eye/metabolights_zooma.tsv"
        },
        "ukbiobank": {
            "uri": "https://github.com/EBISPOT/EFO-UKB-mappings",
            "import_url": "https://raw.githubusercontent.com/EBISPOT/EFO-UKB-mappings/master/ukbiobank_zooma.txt"
        },
        "EBI-BioSamples": {
            "uri": "https://www.ebi.ac.uk/biosamples/",
            "import_url":
  "https://ftp.ebi.ac.uk/pub/databases/biosamples/zooma/biosamples_zooma_curations.csv"
        },
        "FAANG": {
            "uri": "https://www.ebi.ac.uk/vg/faang",
            "import_url": "https://api.faang.org/files/faang_zooma_mappings.tsv"
        },
        "HCA": {
            "uri": "https://www.ebi.ac.uk/about/collaborations/human-cell-atlas",
            "import_url": "https://raw.githubusercontent.com/ebi-ait/hca-ebi-wrangler-central/master/src/outputs/current_zooma_import.txt"
        },
        "GWAS": {
            "uri": "http://www.ebi.ac.uk/gwas",
            "import_url": "https://ftp.ebi.ac.uk/pub/databases/gwas/releases/latest/gwas-efo-trait-mappings.tsv",
            "column_map": {
                "Disease trait": "PROPERTY_VALUE",
                "EFO URI": "SEMANTIC_TAG"
            }
        }
    },
    "prefix_map": {
        "owl": "http://www.w3.org/2002/07/owl#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "xml": "http://www.w3.org/XML/1998/namespace",
        "swrl": "http://www.w3.org/2003/11/swrl#",
        "swrlb": "http://www.w3.org/2003/11/swrlb#",
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "dc": "http://purl.org/dc/elements/1.1/",
        "oac": "http://www.openannotation.org/ns/",
        "prov": "http://www.w3.org/TR/prov-o/",
        "zooma": "http://www.ebi.ac.uk/fgpt/zooma/",
        "zoomaterms": "http://rdf.ebi.ac.uk/terms/zooma/",
        "zoomaresource": "http://rdf.ebi.ac.uk/resource/zooma/",
        "annotation": "http://rdf.ebi.ac.uk/resource/zooma/annotation/",
        "propval": "http://rdf.ebi.ac.uk/resource/zooma/propertyvalue/",
        "ebi": "http://www.ebi.ac.uk/",
        "ebiresource": "http://rdf.ebi.ac.uk/resource/",
        "arrayexpress": "http://www.ebi.ac.uk/arrayexpress/",
        "aeresource": "http://rdf.ebi.ac.uk/resource/zooma/arrayexpress/",
        "aeannotation": "http://rdf.ebi.ac.uk/resource/zooma/arrayexpress/annotation/",
        "aeexperiment": "http://rdf.ebi.ac.uk/resource/zooma/arrayexpress/experiment/",
        "aeproperty": "http://rdf.ebi.ac.uk/resource/zooma/arrayexpress/property/",
        "gxa": "http://www.ebi.ac.uk/gxa/",
        "gxaresource": "http://rdf.ebi.ac.uk/resource/zooma/gxa/",
        "gxaannotation": "http://rdf.ebi.ac.uk/resource/zooma/gxa/annotation/",
        "gxaexperiment": "http://rdf.ebi.ac.uk/resource/zooma/gxa/experiment/",
        "gxaproperty": "http://rdf.ebi.ac.uk/resource/zooma/gxa/property/",
        "genome": "http://www.genome.gov/",
        "gwas": "http://www.genome.gov/gwastudies/",
        "gwasresource": "http://rdf.ebi.ac.uk/resource/zooma/gwas/",
        "gwasannotation": "http://rdf.ebi.ac.uk/resource/zooma/gwas/annotation/",
        "gwassnp": "http://rdf.ebi.ac.uk/resource/zooma/gwas/snp/",
        "gwasproperty": "http://rdf.ebi.ac.uk/resource/zooma/gwas/property/",
        "owlresource": "http://rdf.ebi.ac.uk/resource/zooma/owl/",
        "owlannotation": "http://rdf.ebi.ac.uk/resource/zooma/owl/annotation/",
        "owlproperty": "http://rdf.ebi.ac.uk/resource/zooma/owl/property/",
        "efo": "http://www.ebi.ac.uk/efo/",
        "snap": "http://www.ifomis.org/bfo/1.1/snap#",
        "span": "http://www.ifomis.org/bfo/1.1/span#",
        "cl": "http://purl.org/obo/owl/CL#",
        "obo": "http://purl.obolibrary.org/obo/",
        "oboinowl": "http://www.geneontology.org/formats/oboInOwl#",
        "ncbitaxon": "http://purl.org/obo/owl/NCBITaxon#",
        "bto": "http://purl.org/obo/owl/BTO#",
        "pato": "http://purl.org/obo/owl/PATO#",
        "pubmed": "http://europepmc.org/abstract/MED/",
        "orpha": "http://www.orphanet.org/rdfns#"
    }
}
