{
  "id": "analyte-lipid",
  "domain": "analyte",
  "note": "GENERATED by tools/generate_rules_from_script.py from LIPID_PANEL_REPLACEMENTS @236 (normalize_lipid_panel_phrase). Verbatim; applied as a search variant.",
  "appliesWhen": {
    "propertyTypeIn": [
      "measurement",
      "analyte",
      "protein",
      "metabolite",
      "protein_name",
      "metabolite_name"
    ]
  },
  "rules": [
    {
      "id": "lipid-panel-normalized-variant",
      "stage": "rewrite",
      "priority": 20,
      "note": "LIPID_PANEL_REPLACEMENTS @236",
      "then": [
        {
          "addNormalizedVariant": {
            "subs": [
              {
                "pattern": "(?i)\\bapo[-\\s]?a1\\b",
                "replacement": "apolipoprotein a 1"
              },
              {
                "pattern": "(?i)\\bapo[-\\s]?a2\\b",
                "replacement": "apolipoprotein a 2"
              },
              {
                "pattern": "(?i)\\bapo[-\\s]?(?:8|β|Β|в|В|ß)\\b",
                "replacement": "apolipoprotein b"
              },
              {
                "pattern": "(?i)\\bapolipoprotein\\s+a[-\\s]?1\\b",
                "replacement": "apolipoprotein a-i"
              },
              {
                "pattern": "(?i)\\bapolipoprotein\\s+a[-\\s]?2\\b",
                "replacement": "apolipoprotein a-ii"
              },
              {
                "pattern": "(?i)\\bapo[-\\s]?b100\\b",
                "replacement": "apolipoprotein b-100"
              },
              {
                "pattern": "(?i)\\bapo[-\\s]?b\\b",
                "replacement": "apolipoprotein b"
              },
              {
                "pattern": "(?i)\\bapob\\b",
                "replacement": "apolipoprotein b"
              },
              {
                "pattern": "(?i)\\b(apolipoprotein\\s+(?:a[-\\s]?(?:i{1,3}|[12])|b(?:[-\\s]?100)?))\\s+in\\s+(?:all\\s+)?(?:(?:very\\s+small|small|medium|large|very\\s+large|extremely\\s+large)\\s+)?(?:vldl|ldl|hdl|idl)\\b",
                "replacement": "\\1"
              },
              {
                "pattern": "(?i)\\b(?:total\\s+)?apolipoprotein\\s+b(?:[-\\s]?100)?\\s+particle\\s+(?:number|concentration|count|no\\.?)\\b",
                "replacement": "apolipoprotein b measurement"
              },
              {
                "pattern": "(?i)\\bcholesterol esters\\b",
                "replacement": "cholesteryl esters"
              },
              {
                "pattern": "(?i)\\bce\\b",
                "replacement": "cholesteryl esters"
              },
              {
                "pattern": "(?i)\\bch\\b",
                "replacement": "cholesterol"
              },
              {
                "pattern": "(?i)\\btriglycerides\\b",
                "replacement": "triglyceride"
              },
              {
                "pattern": "(?i)\\bmufa\\b",
                "replacement": "monounsaturated fatty acids"
              },
              {
                "pattern": "(?i)\\bpufa\\b",
                "replacement": "polyunsaturated fatty acids"
              },
              {
                "pattern": "(?i)\\bufa\\b",
                "replacement": "unsaturated fatty acids"
              },
              {
                "pattern": "(?i)\\bsfa\\b",
                "replacement": "saturated fatty acids"
              },
              {
                "pattern": "(?i)\\bmonounsaturated fatty acid\\s*/\\s*total fatty acid(?:s)?(?:\\s*\\(%\\))?\\b",
                "replacement": "monounsaturated fatty acids to total fatty acids percentage"
              },
              {
                "pattern": "(?i)\\bpolyunsaturated fatty acid\\s*/\\s*total fatty acid(?:s)?(?:\\s*\\(%\\))?\\b",
                "replacement": "polyunsaturated fatty acids to total fatty acids percentage"
              },
              {
                "pattern": "(?i)\\bsaturated fatty acid\\s*/\\s*total fatty acid(?:s)?(?:\\s*\\(%\\))?\\b",
                "replacement": "saturated fatty acids to total fatty acids percentage"
              },
              {
                "pattern": "(?i)\\bunsaturated fatty acid\\s*/\\s*total fatty acid(?:s)?(?:\\s*\\(%\\))?\\b",
                "replacement": "unsaturated fatty acids to total fatty acids percentage"
              },
              {
                "pattern": "(?i)\\bmufa\\s*/\\s*pufa\\b",
                "replacement": "monounsaturated fatty acids to polyunsaturated fatty acids ratio"
              },
              {
                "pattern": "(?i)\\bufa\\s*/\\s*pufa\\b",
                "replacement": "unsaturated fatty acids to polyunsaturated fatty acids ratio"
              },
              {
                "pattern": "(?i)\\bacetoacetic acid\\b",
                "replacement": "acetoacetate"
              },
              {
                "pattern": "(?i)\\bformic acid\\b",
                "replacement": "formate"
              },
              {
                "pattern": "(?i)\\bcitric acid\\b",
                "replacement": "citric acid/isocitric acid"
              },
              {
                "pattern": "(?i)\\bdihydrothymine\\b",
                "replacement": "5,6-dihydrothymine"
              },
              {
                "pattern": "(?i)\\bacetic acid\\b",
                "replacement": "acetate"
              },
              {
                "pattern": "(?i)\\bin all (vldl|ldl|hdl|idl)\\b",
                "replacement": "in \\1"
              },
              {
                "pattern": "(?i)\\bextremely large (vldl|ldl|hdl)\\b",
                "replacement": "very large \\1"
              },
              {
                "pattern": "(?i)\\bparticle number\\b",
                "replacement": "particle concentration"
              },
              {
                "pattern": "(?i)\\ball all\\b",
                "replacement": "all"
              },
              {
                "pattern": "(?i)\\bn-acetylglycoproteins[12]\\b",
                "replacement": "n-acetylglycoproteins"
              },
              {
                "pattern": "(?i)\\bmeasurement levels?\\b",
                "replacement": "measurement"
              },
              {
                "pattern": "(?i)\\blevels?\\s+measurement\\b",
                "replacement": "measurement"
              },
              {
                "pattern": "(?i)\\bmeasurements\\b",
                "replacement": "measurement"
              }
            ]
          }
        }
      ]
    }
  ]
}
