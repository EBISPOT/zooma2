{
  "id": "trait-default",
  "domain": "trait",
  "note": "Faithful transcription of the trait engine's static gating/normalisation from map_measurement_efo.py. Scope (disease/phenotype) is a Zooma-propertyType-to-script-engine mapping, not script content.",
  "appliesWhen": { "propertyTypeIn": ["disease", "phenotype"] },
  "rules": [
    { "id": "noise-self-report", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[0] @1013",
      "then": [ { "normalize": { "pattern": "(?i)^\\s*self\\s*report\\s*[-:]\\s*", "replacement": " " } } ] },
    { "id": "noise-noncancer-illness-self-reported", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[1] @1014",
      "then": [ { "normalize": { "pattern": "(?i)^\\s*non[-\\s]*cancer\\s+illness\\s+code\\s*,?\\s*self[-\\s]*reported\\s*[-:]\\s*", "replacement": " " } } ] },
    { "id": "noise-cancer-code-self-reported", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[2] @1015",
      "then": [ { "normalize": { "pattern": "(?i)^\\s*cancer\\s+code\\s*,?\\s*self[-\\s]*reported\\s*[-:]\\s*", "replacement": " " } } ] },
    { "id": "noise-treatment-medication-code", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[3] @1016",
      "then": [ { "normalize": { "pattern": "(?i)^\\s*treatment\\s+or\\s+medication\\s+code\\s*[-:]\\s*", "replacement": "treatment or medication use - " } } ] },
    { "id": "noise-qcd-paren", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[4] @1017",
      "then": [ { "normalize": { "pattern": "(?i)\\(\\s*qc(?:['`’]?d)?\\s*\\)", "replacement": " " } } ] },
    { "id": "noise-gene-based-burden-paren", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[5] @1018",
      "then": [ { "normalize": { "pattern": "(?i)\\(\\s*gene\\s*[- ]?based\\s+burden\\s*\\)", "replacement": " " } } ] },
    { "id": "noise-gene-based-burden", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[6] @1019",
      "then": [ { "normalize": { "pattern": "(?i)\\bgene\\s*[- ]?based\\s+burden\\b", "replacement": " " } } ] },
    { "id": "noise-unknown-primary-paren", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[7] @1020",
      "then": [ { "normalize": { "pattern": "(?i)\\(\\s*unknown\\s+primary\\s*\\)", "replacement": " " } } ] },
    { "id": "noise-plus-slash-minus", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[8] @1021",
      "then": [ { "normalize": { "pattern": "(?i)\\+\\s*/\\s*-?\\s*", "replacement": " with or without " } } ] },
    { "id": "noise-plus-pipe-minus", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[9] @1022",
      "then": [ { "normalize": { "pattern": "(?i)\\+\\s*\\|\\s*-\\s*", "replacement": " with or without " } } ] },
    { "id": "noise-qcd-word", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[10] @1023",
      "then": [ { "normalize": { "pattern": "(?i)\\bqc(?:['`’]?d)\\b", "replacement": " " } } ] },
    { "id": "noise-nmr-prefix", "stage": "rewrite", "priority": 50,
      "note": "TRAIT_QUERY_NOISE_SUBS[11] @1024",
      "then": [ { "normalize": { "pattern": "(?i)^\\s*nmr\\s+", "replacement": " " } } ] },
    { "id": "suffix-response-value", "stage": "rewrite", "priority": 45,
      "note": "TRAIT_RESPONSE_VALUE_SUFFIX_PATTERNS[0] @1027",
      "then": [ { "normalize": { "pattern": "(?i)\\s*[-:]\\s*(?:yes|no|none|never|ever|current|former|past|unknown)(?:\\s*\\(\\d{1,7}\\))?\\s*$", "replacement": "" } } ] },
    { "id": "suffix-response-nonanswer", "stage": "rewrite", "priority": 45,
      "note": "TRAIT_RESPONSE_VALUE_SUFFIX_PATTERNS[1] @1028",
      "then": [ { "normalize": { "pattern": "(?i)\\s*[-:]\\s*(?:prefer\\s+not\\s+to\\s+answer|do\\s+not\\s+know|dont\\s+know)(?:\\s*\\(\\d{1,7}\\))?\\s*$", "replacement": "" } } ] },
    { "id": "suffix-response-scale", "stage": "rewrite", "priority": 45,
      "note": "TRAIT_RESPONSE_SCALE_SUFFIX_PATTERNS[0] @1031",
      "then": [ { "normalize": { "pattern": "(?i)\\s*[-:]\\s*(?:not\\s+at\\s+all|not\\s+very|slightly|somewhat|fairly|very|extremely)?\\s*(?:easy|difficult|hard|good|poor|well|badly|likely|unlikely|satisfied|unsatisfied)(?:\\s*\\(\\d{1,7}\\))?\\s*$", "replacement": "" } } ] },

    { "id": "reject-non-allowed-trait-ontology", "stage": "gate", "priority": 100,
      "note": "trait_output_id_allowed @5897 / ALLOWED_TRAIT_OUTPUT_PREFIXES @1247 (allowlist; ACTIVE_TRAIT_GO_FALLBACK_IDS is empty at config time, so no GO exception)",
      "when": { "not": { "candidateOntologyIn": ["efo", "mondo", "hp", "oba"] } },
      "then": [ { "reject": { "reason": "term is not in an allowed trait output ontology (EFO/MONDO/HP/OBA)" } } ] },
    { "id": "reject-forbidden-trait-id", "stage": "gate", "priority": 95,
      "note": "FORBIDDEN_TRAIT_IDS @1248",
      "when": { "candidateIdIn": ["PATO_0000461"] },
      "then": [ { "reject": { "reason": "forbidden trait id (FORBIDDEN_TRAIT_IDS)" } } ] },
    { "id": "reject-forbidden-trait-labels", "stage": "gate", "priority": 90,
      "note": "FORBIDDEN_TRAIT_LABEL_KEYS @1257 (exact normalized-label membership)",
      "when": { "candidateLabelMatches": "(?i)^(normal|mental health|family relationship|volume|area|size|shape)$" },
      "then": [ { "reject": { "reason": "forbidden generic trait label (FORBIDDEN_TRAIT_LABEL_KEYS)" } } ] },
    { "id": "reject-descriptor-only-labels", "stage": "gate", "priority": 90,
      "note": "TRAIT_DESCRIPTOR_ONLY_KEYS @5570 (exact normalized-label membership)",
      "when": { "candidateLabelMatches": "(?i)^(light|dark|blonde|blond|brown|black|red|blue|green|grey|gray|other|area|size|shape|volume)$" },
      "then": [ { "reject": { "reason": "descriptor-only label (TRAIT_DESCRIPTOR_ONLY_KEYS)" } } ] },

    { "id": "prefer-trait-output-ontologies", "stage": "select", "priority": 10,
      "note": "TRAIT_PREFERRED_PREFIX_ORDER @1327 {EFO:0, MONDO:1, HP:2, OBA:3}",
      "then": [ { "preferOntologyOrder": { "list": ["efo", "mondo", "hp", "oba"] } } ] }
  ]
}
